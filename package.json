{
  "name": "@ssolstice/bark-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Bark push notification API",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint \"src/**/*.ts\"",
    "format": "oxfmt",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxfmt": "^0.5.0",
    "oxlint": "^0.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint",
      "oxfmt"
    ],
    "docs/**/*.md": [
      "oxfmt"
    ],
    "README.md": [
      "oxfmt"
    ]
  }
}
